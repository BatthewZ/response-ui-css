{
  "name": "@batthewz/response-ui-css",
  "version": "0.15.0",
  "type": "module",
  "description": "Design tokens, a theme contract, responsive scales, and animations for the response-ui design system. Tailwind v4 CSS-first. The foundation layer, usable on its own.",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "docs",
    "AGENTS.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BatthewZ/response-ui-css.git"
  },
  "homepage": "https://github.com/BatthewZ/response-ui-css#readme",
  "bugs": "https://github.com/BatthewZ/response-ui-css/issues",
  "author": "BatthewZ",
  "exports": {
    ".": {
      "style": "./src/index.css",
      "default": "./src/index.css"
    },
    "./no-fonts": {
      "style": "./src/index-no-fonts.css",
      "default": "./src/index-no-fonts.css"
    },
    "./fonts": {
      "style": "./src/fonts.css",
      "default": "./src/fonts.css"
    },
    "./tokens": {
      "style": "./src/tokens/index.css",
      "default": "./src/tokens/index.css"
    },
    "./examples/themes/*": {
      "style": "./src/examples/themes/*.css",
      "default": "./src/examples/themes/*.css"
    },
    "./theme-template": {
      "style": "./src/_theme-template.css",
      "default": "./src/_theme-template.css"
    }
  },
  "peerDependencies": {
    "tailwindcss": "^4"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "design-system",
    "tailwind",
    "tailwindcss-v4",
    "tokens",
    "themes",
    "css",
    "oklch"
  ],
  "license": "MIT"
}
